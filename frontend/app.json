{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.vmathresholdcalc.c7gseu",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Sauvegarder le récapitulatif de vos courses",
        "NSPhotoLibraryAddUsageDescription": "Exporter le récapitulatif dans votre pellicule"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.vmathresholdcalc.c7gseu",
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Sauvegarder le récapitulatif de vos courses",
          "savePhotosPermission": "Exporter le récapitulatif dans votre pellicule"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-vector-icons/ionicons",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
